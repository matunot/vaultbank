# Root environment variables for server
# This file is loaded by the server using dotenv.

# Node environment
NODE_ENV=development
PORT=5000

# Supabase Configuration (optional - leave blank for demo mode)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Configuration
JWT_SECRET=vaultbank-demo-secret-key-2025-secure
JWT_EXPIRES_IN=7d

# CORS Configuration
CLIENT_URL=http://localhost:3000

# PostgreSQL connection string (replace with your actual credentials)
DATABASE_URL=postgres://postgres:VaultBank123!@localhost:5432/vaultbank

# Admin Credentials
ADMIN_EMAIL=admin@vaultbank.com
ADMIN_PASSWORD=admin123
TRANSFER_TOKEN_SECRET=your-strong-random-secret-key-please-change

# Payment provider configuration (placeholders for demo)
STRIPE_PUBLIC_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
PAYPAL_CLIENT_ID=placeholder_paypal_client_id
PAYPAL_CLIENT_SECRET=placeholder_paypal_client_secret
BANK_API_KEY=placeholder_bank_api_key

# OAuth & SMTP configuration (add your real values)
GOOGLE_CLIENT_ID=placeholder_google_client_id
GOOGLE_CLIENT_SECRET=placeholder_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

GITHUB_CLIENT_ID=placeholder_github_client_id
GITHUB_CLIENT_SECRET=placeholder_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VaultBank <no-reply@vaultbank.com>"