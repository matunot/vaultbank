{
    "version": 2,
    "installCommand": "cd api && npm install --no-audit --no-fund",
    "buildCommand": "echo \"Client build completed in CI - skipping\"",
    "outputDirectory": "client/build",
    "functions": {
        "api/login.js": {
            "maxDuration": 10
        },
        "api/transfers.js": {
            "maxDuration": 10
        },
        "api/payments.js": {
            "maxDuration": 10
        },
        "api/index.js": {
            "maxDuration": 10
        }
    },
    "rewrites": [
        {
            "source": "/api/auth/(.*)",
            "destination": "/api/login"
        },
        {
            "source": "/api/payments/(.*)",
            "destination": "/api/payments"
        },
        {
            "source": "/api/transfers/(.*)",
            "destination": "/api/transfers"
        },
        {
            "source": "/api/login/(.*)",
            "destination": "/api/login"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index"
        },
        {
            "source": "/((?!api/|.*\\.[a-zA-Z0-9]+).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)\\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        }
    ]
}