{
    "version": 2,
    "installCommand": "cd api && npm install --no-audit --no-fund",
    "buildCommand": "echo \"Client build completed in CI - skipping\"",
    "outputDirectory": "client/build",
    "functions": {
        "api/login.js": {
            "maxDuration": 10
        },
        "api/transfers.js": {
            "maxDuration": 10
        },
        "api/payments.js": {
            "maxDuration": 10
        },
        "api/index.js": {
            "maxDuration": 10
        }
    },
    "rewrites": [
        {
            "source": "/api/auth/(.*)",
            "destination": "/api/login"
        },
        {
            "source": "/api/payments/(.*)",
            "destination": "/api/payments"
        },
        {
            "source": "/api/transfers/(.*)",
            "destination": "/api/transfers"
        },
        {
            "source": "/api/login/(.*)",
            "destination": "/api/login"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index"
        },
        {
            "source": "/((?!api/|.*\\.[a-zA-Z0-9]+).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)\\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains; preload"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com; connect-src 'self' https://api.stripe.com https://*.razorpay.com https://api.paypal.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-src https://js.stripe.com https://checkout.stripe.com"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "no-referrer-when-downgrade"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                }
            ]
        }
    ]
}