# VaultBank server environment template
# Copy to server/.env and fill in real values. NEVER commit the real file.
#
# Production money movement is VaultBank-native only: the double-entry ledger in
# PostgreSQL plus manually reconciled bank/UPI rails. Legacy third-party
# collection/payout adapters (Stripe, PayPal, Cashfree, Nium) are hard-disabled
# when NODE_ENV=production regardless of the variables below.
# See INR_RAILS_RUNBOOK.md, DIRECT_RAILS_RUNBOOK.md, RECONCILIATION_RUNBOOK.md.

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Public origin used for links inside emails/notifications (single-origin SPA+API).
CLIENT_URL=http://localhost:5173

# ── Database (PostgreSQL / Neon) ─────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/vaultbank

# ── Auth ─────────────────────────────────────────────────────────────────────
# Minimum 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
# HMAC key for tokenized transfer references.
TRANSFER_TOKEN_SECRET=replace-with-another-random-secret
ADMIN_EMAIL=admin@vaultbank.com
# The server refuses well-known default role passwords at boot.
ADMIN_PASSWORD=choose-a-strong-admin-password

# ── Email delivery (signup verification, alerts) ─────────────────────────────
# Without SMTP the verification link is logged instead of emailed.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=replace-me
SMTP_FROM=VaultBank <no-reply@example.com>

# ── Native bank-transfer receiving account (statement-verified credits) ──────
# A credit is posted ONLY after an admin matches the official bank statement.
VB_BANK_DEPOSIT_ENABLED=false
VB_BANK_RECEIVING_CURRENCY=USD
VB_BANK_RECEIVING_BANK_NAME=
VB_BANK_RECEIVING_HOLDER=
VB_BANK_RECEIVING_DETAILS=
# Customer-facing access stays off until compliance sign-off.
VB_BANK_DEPOSIT_CUSTOMER_ACCESS_ENABLED=false

# ── Direct UPI deposits (INR, manual statement verification) ─────────────────
VB_UPI_DEPOSIT_ENABLED=false
VB_UPI_RECEIVING_VPA=
VB_UPI_RECEIVING_NAME=
VB_DIRECT_UPI_CUSTOMER_ACCESS_ENABLED=false

# ── Manual bank payouts (operator sends the transfer, then confirms the UTR) ──
VB_DIRECT_BANK_PAYOUTS_ENABLED=false
# Exactly 64 hex chars (32 random bytes). Never rotate while encrypted requests exist.
VB_DIRECT_PAYOUT_ENCRYPTION_KEY=
VB_DIRECT_BANK_PAYOUT_CUSTOMER_ACCESS_ENABLED=false

# ── Additional currencies (AED GBP EUR CAD AUD SGD NZD CHF HKD) ──────────────
# Each code also needs VB_BANK_RECEIVING_<CODE>_BANK_NAME / _HOLDER / _DETAILS.
VB_MULTICURRENCY_ENABLED=false

# ── USD ACH payout preparation (file export only, no network submission) ─────
VB_USD_ACH_EXPORT_ENABLED=false

# ── Crypto rail (USDC/USDT) ──────────────────────────────────────────────────
# Public xpub only: derives deposit addresses, cannot spend.
USDC_XPUB=
# Hot-wallet key: 0x + 64 hex chars. Enables chain withdrawals.
# Leave empty unless the wallet is intentionally funded.
USDC_HOT_WALLET_KEY=
USDC_DAILY_LIMIT=10000
BASE_RPC_URL=
POLYGON_RPC_URL=

# ── Base Sepolia TEST MODE (never set in production) ─────────────────────────
# USDC_TESTNET_MODE=base-sepolia
# USDC_BASE_SEPOLIA_HOT_WALLET_KEY=
# USDC_BASE_SEPOLIA_RPC_URL=

# ── Legacy third-party providers — production-hard-disabled ──────────────────
# Kept only so local sandbox work remains explicit. These must never be treated
# as a live settlement capability.
PAYMENT_PROVIDER_STRIPE_KEY=
PAYMENT_PROVIDER_STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYMENT_PROVIDER_PAYPAL_CLIENT_ID=
PAYMENT_PROVIDER_PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
NIUM_API_KEY=
NIUM_ENV=sandbox

# ── Observability (optional) ─────────────────────────────────────────────────
SENTRY_DSN=
