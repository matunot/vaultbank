# VaultBank Server Environment Variables
# Copy this file to .env and fill in your values

NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/vaultbank

# Supabase Configuration (optional)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-minimum-32-characters-long
JWT_EXPIRES_IN=7d

# CORS Configuration
CLIENT_URL=http://localhost:3000

# Admin Credentials
ADMIN_EMAIL=admin@vaultbank.com
ADMIN_PASSWORD=admin123
# Tokenized transfer secret (HMAC key for generating and verifying transfer tokens)
TRANSFER_TOKEN_SECRET=your-strong-random-secret-key-please-change

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@vaultbank.com
SMTP_PASS=your-smtp-password
SMTP_FROM=VaultBank <no-reply@vaultbank.com>

# ──────────────────────────────────────────────────────────────
# Payment Provider Configuration (Sandbox/Test Keys)
# ──────────────────────────────────────────────────────────────

# Stripe (Card + Google Pay)
# Get test keys from https://dashboard.stripe.com/test/apikeys
PAYMENT_PROVIDER_STRIPE_KEY=pk_test_your_stripe_public_key
PAYMENT_PROVIDER_STRIPE_SECRET=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Google Pay (via Stripe)
# Get merchant ID from https://pay.google.com/business/console
PAYMENT_PROVIDER_GOOGLEPAY_MERCHANT_ID=your_google_pay_merchant_id

# Razorpay (UPI, Cards, Netbanking for India)
# Get test keys from https://dashboard.razorpay.com/app/keys
PAYMENT_PROVIDER_RAZORPAY_KEY=rzp_test_your_razorpay_key_id
PAYMENT_PROVIDER_RAZORPAY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# PayPal
# Get sandbox keys from https://developer.paypal.com/dashboard/applications/sandbox
PAYMENT_PROVIDER_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYMENT_PROVIDER_PAYPAL_SECRET=your_paypal_sandbox_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# UPI Configuration (uses Razorpay or direct PSP)
PAYMENT_PROVIDER_UPI_PROVIDER=razorpay

# ──────────────────────────────────────────────────────────────
# Optional: Sentry Error Tracking
SENTRY_DSN=https://your-sentry-dsn

# Railway/Vercel Deployment
RAILWAY_ENVIRONMENT=production
