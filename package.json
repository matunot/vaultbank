{
    "name": "vaultbank",
    "version": "1.0.0",
    "description": "VaultBank - Full Stack Banking Application",
    "scripts": {
        "start:client": "cd client && npm start",
        "start:server": "cd server && npm start",
        "dev": "concurrently \"npm run start:client\" \"npm run start:server\"",
        "install:client": "cd client && npm install",
        "install:server": "cd server && npm install",
        "install:all": "npm run install:client && npm run install:server",
        "prebuild": "node -e \"const fs = require('fs'); if (!fs.existsSync('client')) console.log('No client folder, using root build')\"",
        "build": "cd client && npm run build",
        "vercel:build": "npm run build",
        "vercel:dev": "npm run dev",
        "lint": "eslint client/src/**/*.js client/src/**/*.jsx"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.59.3",
        "@typescript-eslint/parser": "^8.59.3",
        "concurrently": "^8.2.2",
        "glob": "^10.5.0",
        "rimraf": "^4.4.1",
        "typescript": "^4.9.5"
    },
    "keywords": [
        "banking",
        "react",
        "express",
        "fullstack"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@craco/craco": "^7.1.0",
        "@jridgewell/sourcemap-codec": "^1.5.5",
        "@rollup/plugin-terser": "^1.0.0",
        "bcrypt": "^6.0.0",
        "csv-writer": "^1.6.0",
        "dotenv": "^17.2.3",
        "exceljs": "^4.4.0",
        "express": "^5.1.0",
        "fast-csv": "^4.3.6",
        "file-saver": "^2.0.5",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.1",
        "multer": "^2.1.1",
        "papaparse": "^5.5.3",
        "pdfkit": "^0.17.2",
        "react-beautiful-dnd": "^13.1.1",
        "react-circular-progressbar": "^2.2.0",
        "react-confetti": "^6.4.0",
        "react-icons": "^5.5.0",
        "react-router-dom": "^7.14.2",
        "svgo": "^2.8.2",
        "swiper": "^12.0.3",
        "table": "^6.9.0",
        "winston": "^3.19.0"
    },
    "main": "index.js",
    "engines": {
        "node": "24.x"
    }
}
