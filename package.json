{
  "name": "vaultbank",
  "version": "1.0.0",
  "description": "VaultBank - Full Stack Banking Application",
  "scripts": {
    "start:client": "cd client && npm start",
    "start:server": "cd server && npm start",
    "dev": "concurrently \"npm run start:client\" \"npm run start:server\"",
    "install:client": "cd client && npm install",
    "install:server": "cd server && npm install",
    "install:all": "npm run install:client && npm run install:server",
    "build": "cd client && npm run build",
    "vercel:build": "npm run build",
    "vercel:dev": "npm run dev",
    "preinstall": "node -e \"const v=process.version; if(!/^v24\\./.test(v)){console.warn('Warning: Node 24.x required.'); process.exit(0);}\""
  },
  "devDependencies": {
    "ajv": "^8.12.0",
    "ajv-keywords": "^5.1.0",
    "concurrently": "^8.2.2",
    "schema-utils": "^4.3.3",
    "typescript": "^4.9.5"
  },
  "keywords": [
    "banking",
    "react",
    "express",
    "fullstack"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@craco/craco": "^7.1.0",
    "exceljs": "^4.4.0"
  }
}